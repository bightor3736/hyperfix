# ─────────────────────────────────────────────────────────────
# Hyperfix — environment variables
# Copy to .env.local for local dev, and set the same keys in your host
# (e.g. Vercel → Settings → Environment Variables) for production.
# Never commit real secret values. Public (NEXT_PUBLIC_*) vars ship to the
# browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Project URL + anon key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server only — full DB access, bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used for absolute links / redirects / share URLs.
NEXT_PUBLIC_SITE_URL=https://hyperfix.app

# ── Web Push (required for "still waiting on you" + streak reminders) ──
# Generate a keypair with:  npx web-push generate-vapid-keys
# Public key also ships to the browser to subscribe the user.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address required by the Web Push spec — must be a mailto: URL.
VAPID_CONTACT_EMAIL=mailto:hello@hyperfix.app

# ── Cron (required for daily reminders) ──────────────────────
# Shared secret; the daily cron endpoint checks `Authorization: Bearer <CRON_SECRET>`.
# Set the same value on your scheduler (Vercel Cron / external) calling /api/cron/daily.
CRON_SECRET=

# ── Stripe (required for Power-Up checkout) ──────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ── Email (Resend — transactional + reminder emails) ─────────
RESEND_API_KEY=

# ── Spotify (optional — "now playing" integration) ───────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Admin / setup endpoints (optional — guard one-off admin routes) ──
ADMIN_SECRET=
SETUP_SECRET=

# ── Supabase CLI (optional — only for running migrations via CLI) ─────
SUPABASE_ACCESS_TOKEN=
